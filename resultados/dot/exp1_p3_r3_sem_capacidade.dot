digraph G {
  node [shape=circle];
  0 [style=filled, fillcolor=gray];
  1 [style=filled, fillcolor=gray];
  2 [style=filled, fillcolor=gray];
  0 -> 1 [label="1", penwidth=2];
  0 -> 2 [label="1", penwidth=2];
  1 -> 0 [label="1", penwidth=2];
  1 -> 2 [label="1", penwidth=2];
  2 -> 0 [label="1", penwidth=2];
  2 -> 1 [label="1", penwidth=2];
}